body {
    max-width: 1000vw;
}
 
header {     
    background-color: #01647c;
    color: #ffffff;
    text-align: center;
    margin: 0 auto;
    padding: 16px;
}

main {
    background-color: #ffffff;
    color: #01647c;
    margin: 0 auto;
    padding: 16px;

    display: flex;
    flex-wrap: wrap;
}   
 
article{
    display: flex;

    border: 1px solid #01647c;

    margin: 16px;
    gap: 16px;
    padding: 16px;

    flex: 1 1 25%;

    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
}

img {
    width: 80px;
    height: 80px;
}

.artigo-autor {
    font-weight: bold;
}
